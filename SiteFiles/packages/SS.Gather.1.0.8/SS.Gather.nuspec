<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>SS.Gather</id>
    <version>1.0.8</version>
    <title>SiteServer CMS 采集插件</title>
    <authors>SiteServer CMS</authors>
    <owners>SiteServer CMS</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectUrl>https://github.com/siteserver/SS.Gather/</projectUrl>
    <iconUrl>https://storage.sscms.com/plugins/ss.gather/logo.svg</iconUrl>
    <description>SiteServer CMS 采集插件</description>
    <copyright>Copyright © SiteServer CMS</copyright>
    <tags>SiteServer CMS Plugin</tags>
    <repository url="https://github.com/siteserver/SS.Gather" />
    <dependencies>
      <group targetFramework=".NETFramework4.5.2">
        <dependency id="ExcelDataReader.DataSet" version="3.6.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.AspNet.WebApi.Core" version="5.2.7" exclude="Build,Analyzers" />
        <dependency id="NDesk.Options" version="0.2.1" exclude="Build,Analyzers" />
        <dependency id="SiteServer.Plugin" version="2.3.15" exclude="Build,Analyzers" />
        <dependency id="System.Runtime.Caching" version="4.5.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="System.Web" targetFramework=".NETFramework4.5.2" />
    </frameworkAssemblies>
